# KSRTC Kalaburagi Division - BusPulse Environment Configuration

# Flask Settings
FLASK_APP=backend/app.py
FLASK_ENV=development
PORT=5000
DEBUG=True
DATA_SOURCE=Dataset.xlsx
API_VERSION=v1

# Supabase Credentials (optional — app falls back to local files if not set)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

